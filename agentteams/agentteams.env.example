# Copy to a local ignored file such as .agentteams.env. Never commit credentials.
AT_MODEL=gpt-5.6-luna
AT_LLM_BASE_URL=https://api.hostcentral.cc/v1
AT_LLM_WIRE_API=responses
AT_TEAM_NAME=cogniguide-demo
AT_TEAM_LEADER=cogniguide-demo-leader
AT_MANAGER_ROOM=manager
AT_TASK_ROOM=<TEAM_ROOM_CREATED_BY_AGENTTEAMS>

# Must be reachable from AgentTeams Worker containers; do not use 127.0.0.1
# unless the gateway runs in the same container.
MOCK_TOOL_BASE_URL=http://host.docker.internal:18089
MOCK_TOOL_BIND_HOST=0.0.0.0
MOCK_TOOL_PORT=18089
